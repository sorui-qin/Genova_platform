IMAGE_REPOSITORY=genova
PLATFORM_VERSION=20261108

WEB_PORT=18001
POSTGRES_DB=genova
POSTGRES_USER=genova
# 为以下三项分别填写 openssl rand -hex 32 生成的独立值。
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# 默认关闭。开启后自动清理满 14 天且不再被有效任务、结果或会话引用的数据。
DATA_RETENTION_ENABLED=false

# 忘记密码：用户访问平台的地址，须含 /genova 子路径（如 http://example.edu.cn:18001/genova），重置链接以它为前缀。
PUBLIC_BASE_URL=
# 发信 SMTP；465 走 SSL，其他端口走 STARTTLS。留空则找回页提示联系管理员。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 上传限制（MB）：非结构文件单个上限、每个用户的数据中心总配额、访客账号的总配额。单次上传请求另受前端 nginx 1 GB 限制。
UPLOAD_FILE_MAX_MB=500
USER_STORAGE_QUOTA_MB=5120
GUEST_STORAGE_QUOTA_MB=500

SURFGEN_CUDA_VISIBLE_DEVICES=0
DELETE_CUDA_VISIBLE_DEVICES=0
TARPASS_CPUS=8
TARPASS_BATCH_SIZE=64

# Personal Agent APIs are configured in Settings. Preserve JWT_SECRET when migrating encrypted keys.

# Agent turn budgets; model window 0 means unverified (input cap still applies).
AGENT_REQUEST_OUTPUT_TOKENS=8192
AGENT_TURN_OUTPUT_TOKENS=32768
AGENT_TURN_REQUESTS=16
AGENT_TURN_TOOLS=24
AGENT_TURN_SECONDS=240
AGENT_TURN_LEASE_SECONDS=300
AGENT_CONTEXT_TARGET_TOKENS=98304
AGENT_CONTEXT_MAX_INPUT_TOKENS=131072
AGENT_CONTEXT_BYTES=2097152

# 允许用户选择的无认证 HTTP(S) 代理，逗号分隔；留空仅允许直连。
# 地址从后端容器访问，如 http://host.docker.internal:7897。
AGENT_PROXY_ALLOWED_URLS=

# 新建默认使用两阶段准备；关闭不影响已有 v4 读取或已入队任务。

# CPU threads used by protein preparation; capped by available CPU affinity.
OPENMM_CPU_THREADS=8

# 已有实例更新时设为 0，跳过启动期建表、迁移及数据初始化；全新部署使用 1。
AUTO_CREATE_TABLES=1
