# Copy to .env and replace all three CHANGE_ME values before starting services.
# Use a different `openssl rand -hex 32` value for each secret.
POSTGRES_DB=genova
POSTGRES_USER=genova
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Opt-in: retain user uploads, results and Agent history for 14 days, extending referenced data.
DATA_RETENTION_ENABLED=false

# Compose expands these references when loading .env. Use container ports here.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# SurfGen and TarPass share this GPU and /app/data/.locks/gpu-0.lock.
SURFGEN_CUDA_VISIBLE_DEVICES=0
TARPASS_CPUS=8
TARPASS_BATCH_SIZE=64

# Published model images; set your registry repository before pulling.
IMAGE_REPOSITORY=genova
PLATFORM_VERSION=1.0.2

# Personal Agent APIs are configured in Settings. Preserve JWT_SECRET when migrating encrypted keys.

# Agent turn budgets; model window 0 means unverified (input cap still applies).
AGENT_REQUEST_OUTPUT_TOKENS=8192
AGENT_TURN_OUTPUT_TOKENS=32768
AGENT_TURN_REQUESTS=16
AGENT_TURN_TOOLS=24
AGENT_TURN_SECONDS=240
AGENT_TURN_LEASE_SECONDS=300
AGENT_CONTEXT_TARGET_TOKENS=98304
AGENT_CONTEXT_MAX_INPUT_TOKENS=131072
AGENT_CONTEXT_BYTES=2097152

# 允许用户选择的无认证 HTTP(S) 代理，逗号分隔；留空仅允许直连。
# 地址从后端容器访问，如 http://host.docker.internal:7897。
AGENT_PROXY_ALLOWED_URLS=
# Trusted HTTP(S) platform address for remote ChatGPT authorization, including /genova.
PUBLIC_BASE_URL=

# 新建默认使用两阶段准备；关闭不影响已有 v4 读取或已入队任务。

# CPU threads used by protein preparation; capped by available CPU affinity.
OPENMM_CPU_THREADS=8

# 已有实例更新时设为 0，跳过启动期建表、迁移及数据初始化；全新部署使用 1。
AUTO_CREATE_TABLES=1
